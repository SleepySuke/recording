# 复制为 .env 使用（.env 不进 Git）。必填项缺失时服务启动即报错。

# ---- 数据库 ----
# 应用连接 DSN（指向 recording 库；集成测试另用 TEST_MYSQL_DSN 指向 recording_test，见 tests/integration）。
# 两种部署方式，端口都从这里配：
#   自包含（默认，交付/新机器）：docker compose up -d db 起随仓库 MySQL，宿主端口默认 3306（MYSQL_PORT 可改）。
#   本机共享实例：已有共享 MySQL（如 dataforge-mysql，宿主 3306）时不需起 db，DSN 直接指过去，
#     并在其内自建库 recording / recording_test + 专用用户（root 执行一次）：
#     CREATE DATABASE recording; CREATE DATABASE recording_test;
#     CREATE USER 'recording'@'%' IDENTIFIED BY 'recordingpass';
#     GRANT ALL ON recording.* TO 'recording'@'%'; GRANT ALL ON recording_test.* TO 'recording'@'%';
MYSQL_DSN='recording:recordingpass@tcp(127.0.0.1:3306)/recording?parseTime=true&loc=UTC'
# 集成/E2E 测试库 DSN（make test 与门禁在 shell 环境读，不进 .env；复制到命令行用）：
# TEST_MYSQL_DSN='recording:recordingpass@tcp(127.0.0.1:3306)/recording_test?parseTime=true&loc=UTC'
# compose 全栈冒烟 E-COMPOSE 开关（T13；需 Docker 与 make build 镜像，直连 compose 应用库 recording）：
# E2E_COMPOSE=1 TEST_MYSQL_DSN=… go test ./e2e/ -run TestE2ECompose -race -count=1 -v
# 自带 db 容器的宿主端口映射（仅自包含方式使用）；宿主 3306 被占用时改（如 3307），MYSQL_DSN 同步改。
MYSQL_PORT=3306
# db 容器初始化凭据（自包含方式；与 compose.yaml 一致）
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=recording
MYSQL_USER=recording
MYSQL_PASSWORD=recordingpass
# 构建基础镜像名（docker.io 直连受限的网络才需要，如 docker.m.daocloud.io 前缀；默认官方名）：
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.23-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.20

# ---- LLM（小米 MiMo，OpenAI 兼容；Key 在 platform.xiaomimimo.com 申请）----
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2-flash
LLM_API_KEY=
LLM_TIMEOUT=60s

# ---- HTTP / 运行参数（默认值见详设 §10）----
HTTP_ADDR=:8080
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=20
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=7
DATA_DIR=./data/recordings
# 上传限制与超时（详设 §5.1：读空闲与总超时分开；单文件 50MiB，请求体总上限预留 multipart 开销）
UPLOAD_MAX_FILE_MB=50
UPLOAD_MAX_BODY_MB=53
UPLOAD_MIN_FREE_DISK_MB=512
UPLOAD_READ_TIMEOUT=30s
UPLOAD_TOTAL_TIMEOUT=10m
WORKER_CONCURRENCY=3
TASK_POLL_INTERVAL=1s
# Mock ASR：当前服务并未接真实语音识别，转写文本由此替身生成。
# 不设置 = 默认演练模式：按 task_id 固定地等待 5～15 秒，约 20% 任务失败（40001）。
# 设为 ≥0 时长（如 100ms）= 确定性模式：固定等待后恒成功；接入真实 LLM 时推荐设为 100ms，
# 这样可将测试焦点放在 LLM 请求、认证、输出校验和落库，且不会等待或碰到随机失败。
# MOCK_ASR_DELAY=100ms
# 仅与 MOCK_ASR_DELAY 同时设置才有意义：每个 task_id 的首轮转写失败（40001），
# 手动 POST /v1/tasks/{task_id}/retry 后第二轮成功。用于演练失败、重试和 attempt 从 1 到 2 的变化。
# MOCK_ASR_FAIL_FIRST=false
DB_QUERY_TIMEOUT=3s
SHUTDOWN_TIMEOUT=20s
CLEANUP_INTERVAL=30s
RECOVERY_MODE=reset
